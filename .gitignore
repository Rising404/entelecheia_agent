# 私有官方原文缓存：仅供本地复核，不提交受版权保护的全文
data/sources_raw_local/

# benchmark-owned 逐次评测原始输出不入库；目录说明可提交
evals/**/results/**
!evals/**/results/
!evals/**/results/README.md
!evals/**/results/*.summary.json
!evals/**/results/*.baseline.json
# 历史结果默认私有；统计、说明和下方明确审阅的逐题副本例外。
evals/**/previous_results/**
!evals/**/previous_results/
!evals/**/previous_results/README.md
!evals/**/previous_results/*.summary.json
!evals/**/previous_results/*.baseline.json
# 仅三个经过审阅的历史分析文档可公开。
!/evals/docbench/previous_results/analysis/
/evals/docbench/previous_results/analysis/*
!/evals/docbench/previous_results/analysis/README.md
!/evals/docbench/previous_results/analysis/EVALUATION_REVIEW.md
!/evals/docbench/previous_results/analysis/FAILURE_ATTRIBUTION.md
# 逐题公开投影：仅本次两组归档、指定文件类型；隐私门禁另核验精确清单及 SHA-256。
!/evals/docbench/previous_results/showcase_125/
!/evals/docbench/previous_results/showcase_125/**/
!/evals/docbench/previous_results/showcase_125/README.md
!/evals/docbench/previous_results/showcase_125/publication_manifest.json
!/evals/docbench/previous_results/showcase_125/runs/*/run_manifest.json
!/evals/docbench/previous_results/showcase_125/runs/*/cases/*/result.json
!/evals/docbench/previous_results/showcase_125/runs/*/cases/*/trajectory.json
!/evals/docbench/previous_results/showcase_125/runs/*/scoring/summary.json
!/evals/docbench/previous_results/showcase_125/runs/*/scoring/cases/*.json
!/evals/docbench/previous_results/gate_off_highland235b_123/
!/evals/docbench/previous_results/gate_off_highland235b_123/**/
!/evals/docbench/previous_results/gate_off_highland235b_123/README.md
!/evals/docbench/previous_results/gate_off_highland235b_123/publication_manifest.json
!/evals/docbench/previous_results/gate_off_highland235b_123/runs/*/run_manifest.json
!/evals/docbench/previous_results/gate_off_highland235b_123/runs/*/cases/*/result.json
!/evals/docbench/previous_results/gate_off_highland235b_123/runs/*/cases/*/trajectory.json
!/evals/docbench/previous_results/gate_off_highland235b_123/runs/*/scoring/summary.json
!/evals/docbench/previous_results/gate_off_highland235b_123/runs/*/scoring/cases/*.json
# 本地原始答案、轨迹与复核归档整目录隔离；包括其中的 README 和 JSON。
/evals/docbench/results/private_runs/
/evals/docbench/previous_results/private_runs/
# 下载的 benchmark 原文默认只保存在本机；manifest/说明文件可提交
evals/**/sources/**
!evals/**/sources/
!evals/**/sources/README.md
!evals/**/sources/*.manifest.json
# 上游 benchmark 代码：DocBench 无许可证（all rights reserved），只允许本机 checkout，
# 不得 vendor 进仓库。可复现性由 evals/*/upstream.manifest.json 的 pinned commit + sha256 保证。
third_party/
var/third_party/
# benchmark 官方问答文件与我们提交给官方脚本的答案，同样不入库
evals/**/questions/**
!evals/**/questions/
!evals/**/questions/README.md
