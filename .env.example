# 可选的 CLI 环境模板；GUI 可直接在设置中填写 provider/profile。
# 真实值只放在源码外用户配置目录的 .env（见 configs/local/README.md），不要放回仓库。
# 空值不覆盖已有 GUI 配置。provider 可选 anthropic-compatible / openai-compatible。
PERSONAGRAPH_MODEL_PROVIDER=
PERSONAGRAPH_REQUEST_DIALECT=
PERSONAGRAPH_BASE_URL=
PERSONAGRAPH_API_KEY=
PERSONAGRAPH_MODEL=
# 可选输出上限，不是上下文窗口；不填则使用当前 Runtime/profile 的预算。
PERSONAGRAPH_MAX_TOKENS=
# PERSONAGRAPH_TEMPERATURE=0.2
# PERSONAGRAPH_JSON_MODE=0

# 视觉模型独立配置；留空不代表具备视觉能力。
PERSONAGRAPH_VISION_PROVIDER=
PERSONAGRAPH_VISION_BASE_URL=
PERSONAGRAPH_VISION_API_KEY=
PERSONAGRAPH_VISION_MODEL=

# 以下为当前生产检索默认值；模型资源须先显式准备，见 README。
# 不再由模板关闭 reranker，或把缺模型误报成完整检索能力。
# PERSONAGRAPH_RETRIEVAL_PROFILE=bge_m3
# PERSONAGRAPH_RETRIEVAL_RERANKER=bge_v2_m3
# PERSONAGRAPH_RETRIEVAL_FAILURE_POLICY=strict

# 网页搜索提供方设置。真实密钥只能放在仓库外的用户配置目录 .env 中。
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
# PERSONAGRAPH_SEARCH_PROVIDER_ORDER=firecrawl,ddg
